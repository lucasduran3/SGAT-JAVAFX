<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<DialogPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="formDialogPane"
            prefWidth="500">
    
    <stylesheets>
        <URL value="@styles/form.css" />
    </stylesheets>

    <headerText>Agregar ítem a la venta</headerText>

    <content>
        <VBox styleClass="formContainer">
            <Label styleClass="formSubtitle" text="Seleccione un producto y complete la cantidad.&#10;Los campos con * son obligatorios."
                   wrapText="true"/>

            <GridPane hgap="20" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Producto -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                    <Label text="* Producto" styleClass="fieldLabel"/>
                    <ComboBox fx:id="productComboBox" maxWidth="Infinity" promptText="Seleccione un producto..." styleClass="formField"/>
                    <Label fx:id="errorProduct" styleClass="error"/>
                </VBox>

                <!-- Precio unitario (readonly, se llena al seleccionar producto) -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Precio de venta (unitario)" styleClass="fieldLabel"/>
                    <TextField fx:id="unitPriceField" promptText="0.00" editable="false" styleClass="formField"
                               style="-fx-background-color: #F0F0F0;"/>
                    <Label fx:id="errorUnitPrice" styleClass="error"/>
                </VBox>

                <!-- Cantidad -->
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="* Cantidad" styleClass="fieldLabel"/>
                    <TextField fx:id="ammountField" promptText="1" styleClass="formField"/>
                    <Label fx:id="errorAmmount" styleClass="error"/>
                </VBox>

                <!-- Subtotal (readonly, calculado) -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                    <Label text="Subtotal" styleClass="fieldLabel"/>
                    <TextField fx:id="subtotalField" promptText="0.00" editable="false" styleClass="formField"
                               style="-fx-background-color: #F0F0F0; -fx-font-weight: bold;"/>
                </VBox>

            </GridPane>
        </VBox>
    </content>

    <buttonTypes>
        <ButtonType fx:constant="OK"/>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>

</DialogPane>
