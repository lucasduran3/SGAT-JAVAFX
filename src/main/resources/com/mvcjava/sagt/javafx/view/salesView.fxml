<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mvcjava.sagt.javafx.controller.SalesController"
      styleClass="tableContainer"
      spacing="15">

    <stylesheets>
        <URL value="@styles/mainView.css"/>
    </stylesheets>

    <!-- ── Barra de herramientas MASTER ──────────────────────────────────── -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Buscar venta..." prefWidth="250" styleClass="searchInput"/>
        
        <Button text="Filtrar" styleClass="ghostBtn" onAction="#handleFilterToggle">
            <graphic><FontAwesomeIconView glyphName="FILTER" glyphSize="14"/></graphic>
        </Button>
        
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Agregar venta"   styleClass="btnPrimary" onAction="#handleAddSale">
            <graphic>
                <FontAwesomeIconView glyphName="PLUS" glyphSize="14"/>
            </graphic>    
        </Button>
        
        <Button text="Guardar cambios" styleClass="btnSuccess" onAction="#handleSaveChanges">
            <graphic>
                <FontAwesomeIconView glyphName="SAVE" glyphSize="14"/>
            </graphic>
        </Button>
        
        <Button text="Eliminar" styleClass="btnDanger" onAction="#handleDeleteSale">
            <graphic>
                <FontAwesomeIconView glyphName="TRASH" glyphSize="14"/>
            </graphic>
        </Button>
        
        <Button text="Recargar" styleClass="btnWarning" onAction="#handleReload">
            <graphic>
                <FontAwesomeIconView glyphName="REFRESH" glyphSize="14"/>
            </graphic>    
        </Button>
        
    </HBox>

    <HBox fx:id="tableAndFilterContainer" spacing="0" VBox.vgrow="ALWAYS">
        <SplitPane orientation="VERTICAL" HBox.hgrow="ALWAYS" dividerPositions="0.5" styleClass="splitTableContainer">

            <!-- ── MASTER ──────────────────────────────────────────────────────── -->
            <VBox>
                <TableView fx:id="salesTable">
                    <placeholder>
                        <Label text="No hay ventas registradas"/>
                    </placeholder>
                </TableView>
                
                <HBox alignment="CENTER" spacing="12" styleClass="paginationBar">
                    <Button fx:id="previousPageButton" text="Anterior" styleClass="ghostBtn" />
                    <Label fx:id="pageLabel" styleClass="paginationLabel" />
                    <Button fx:id="nextPageButton" text="Siguiente" styleClass="ghostBtn" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="paginationSummaryLabel" styleClass="paginationSummary" />
                </HBox>
            </VBox>

            <!-- ── DETAIL ──────────────────────────────────────────────────────── -->
            <VBox>
                <!-- Barra de herramientas DETAIL -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="20" right="10" bottom="20" left="10"/>
                    </padding>
                
                    <Label fx:id="detailsLabel"
                        text="Seleccioná una venta para ver su detalle"
                        styleClass="sectionTitle"
                        HBox.hgrow="ALWAYS"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!--
                        El botón "Agregar detalle" sólo se habilita cuando hay una venta
                        seleccionada; la lógica se maneja en SalesController.
                    -->
                    <Button fx:id="addDetailBtn"
                            text="Agregar ítem"
                            styleClass="btnPrimary"
                            onAction="#handleAddDetail"
                            disable="true">
                        <graphic>
                            <FontAwesomeIconView glyphName="PLUS" glyphSize="14"/>
                        </graphic>    
                    </Button>
                
                    <Button fx:id="deleteDetailBtn"
                            text="Eliminar ítem"
                            styleClass="btnDanger"
                            onAction="#handleDeleteDetail"
                            disable="true">
                        <graphic>
                            <FontAwesomeIconView glyphName="TRASH" glyphSize="14"/>
                        </graphic>
                    </Button>
                
                </HBox>

                <TableView fx:id="detailTable" VBox.vgrow="ALWAYS">
                </TableView>
            </VBox>

    </SplitPane>
    
    </HBox>
    

</VBox>
