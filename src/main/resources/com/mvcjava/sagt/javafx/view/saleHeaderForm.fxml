<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<DialogPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="formDialogPane"
            prefWidth="500">
    
    <stylesheets>
        <URL value="@styles/form.css" />
    </stylesheets>

    <headerText>Nueva Venta</headerText>

    <content>
        <VBox styleClass="formContainer">
            <Label styleClass="formSubtitle" text="Complete los datos para registrar una nueva venta.&#10;Los campos con * son obligatorios."
                   wrapText="true"/>

            <GridPane hgap="20" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Número de factura -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="* Número de factura" styleClass="fieldLabel"/>
                    <TextField fx:id="billNumberField" promptText="Ej: 0001-00000001" styleClass="formField"/>
                    <Label fx:id="errorBillNumber" styleClass="error"/>
                </VBox>

                <!-- Fecha -->
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="* Fecha" styleClass="fieldLabel"/>
                    <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
                    <Label fx:id="errorDate" styleClass="error"/>
                </VBox>

                <!-- Cliente -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <Label text="* Cliente" styleClass="fieldLabel"/>
                    <ComboBox fx:id="clientComboBox" maxWidth="Infinity" promptText="Seleccione un cliente..." styleClass="formField"/>
                    <Label fx:id="errorClient" styleClass="error"/>
                </VBox>

                <!-- Método de pago -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                    <Label text="* Método de pago" styleClass="fieldLabel"/>
                    <ComboBox fx:id="paymentMethodComboBox" maxWidth="Infinity" promptText="Seleccione un método..." styleClass="formField"/>
                    <Label fx:id="errorPaymentMethod" styleClass="error"/>
                </VBox>

            </GridPane>
        </VBox>
    </content>

    <buttonTypes>
        <ButtonType fx:constant="OK"/>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>

</DialogPane>
