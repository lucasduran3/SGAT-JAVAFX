<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<DialogPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="formDialogPane"
            prefWidth="500">

    <stylesheets>
        <URL value="@styles/form.css" />
    </stylesheets>
    <headerText>Seleccionar Cliente</headerText>

    <content>
        <VBox styleClass="formContainer">
            <!-- Search bar -->
            <TextField fx:id="searchField"
                       promptText="Buscar por nombre o ID..."
                       styleClass="searchInput"/>

            <!-- Table header -->
            <HBox styleClass="selectHeader" spacing="0">
                <Label text="" prefWidth="40"/>
                <Label text="Razón Social" prefWidth="250" styleClass="fieldLabel"/>
                <Label text="ID" HBox.hgrow="ALWAYS" styleClass="fieldLabel"/>
            </HBox>

            <!-- Client list inside a scroll pane -->
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        prefHeight="260"
                        VBox.vgrow="ALWAYS">
                <VBox fx:id="listContainer" spacing="0"/>
            </ScrollPane>

            <!-- Selection indicator -->
            <Label fx:id="selectionLabel"
                   text="Ningún cliente seleccionado"
                   style="-fx-text-fill: #a0a0a0; -fx-font-style: italic;"/>
        </VBox>
    </content>

    <buttonTypes>
        <ButtonType fx:constant="OK"/>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>

</DialogPane>
